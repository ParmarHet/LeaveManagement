@model LeavePro.Models.UserViewModel
@{
    ViewData["Title"] = "Update System Role";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-8">
        <div class="page-header text-center mb-4">
            <h2><i class="bi bi-shield-lock me-2" style="color:#f59e0b"></i>Update User Privileges & Dept</h2>
            <p class="text-muted">Modify access privileges and manager for <strong>@Model.FirstName @Model.LastName</strong></p>
        </div>

        <div class="card border-0 shadow rounded-4 overflow-hidden">
            <div class="bg-warning bg-opacity-10 p-4 text-center">
                <div class="bg-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 64px; height: 64px; border: 2px solid #f59e0b;">
                    <span class="fs-4 fw-bold text-warning">@Model.FirstName[0]@Model.LastName[0]</span>
                </div>
                <div class="fw-bold fs-5">@Model.FirstName @Model.LastName</div>
                <div class="small text-muted mb-1">@Model.Email</div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FirstName" />
                    <input type="hidden" asp-for="LastName" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-4">
                        <label asp-for="Role" class="form-label fw-bold small text-uppercase">Assign Role <span class="text-danger">*</span></label>
                        <select asp-for="Role" class="form-select border-2" asp-items="@(new SelectList(ViewBag.Roles))" style="border-color: #f59e0b;"></select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                        <div class="form-text mt-2 px-2 py-1 bg-light rounded" style="font-size: 0.78rem;">
                            <i class="bi bi-info-circle me-1"></i> Changing a role will immediately update the user's dashboard and sidebar.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DepartmentId" class="form-label fw-bold small text-uppercase">Department <span class="text-danger">*</span></label>
                        <select asp-for="DepartmentId" id="deptSelector" class="form-select border-2" style="border-color: #e2e8f0;" required>
                            <option value="">-- Select Department --</option>
                            @foreach (var dept in ViewBag.Departments)
                            {
                                <option value="@dept.Id" data-manager="@dept.ManagerId">@dept.Name</option>
                            }
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        <div id="deptHint" class="text-danger small mt-1" style="display:none;">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> This department already has a head.
                        </div>
                    </div>

                    <div class="mb-4" id="managerLine">
                        <label asp-for="ManagerId" class="form-label fw-bold small text-uppercase">Manager</label>
                        <select asp-for="ManagerId" class="form-select border-2" style="border-color: #e2e8f0;">
                            <option value="">-- No Manager --</option>
                            @foreach (var manager in ViewBag.Managers)
                            {
                                <option value="@manager.Id">@manager.FirstName @manager.LastName (@manager.Email)</option>
                            }
                        </select>
                        <span asp-validation-for="ManagerId" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mb-2">
                        <button type="submit" class="btn btn-warning fw-bold py-2 shadow-sm">
                            <i class="bi bi-save me-1"></i> Update Details
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">
                             Cancel changes
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            const roleSelect = $('#Role');
            const deptSelect = $('#deptSelector');
            const deptHint = $('#deptHint');
            const managerLine = $('#managerLine');
            const currentUserId = '@Model.Id';

            function updateUI() {
                const isManagerRole = roleSelect.val() === 'Manager';
                const selectedOpt = deptSelect.find('option:selected');
                const managerIdInDept = selectedOpt.data('manager');
                const managerSelect = $('#ManagerId');
                
                if (isManagerRole) {
                    deptSelect.find('option').each(function() {
                        const mId = $(this).data('manager');
                        // Show if no manager, OR if it's currently managed by THIS user
                        if (mId && mId !== currentUserId) {
                             $(this).hide();
                        } else {
                             $(this).show();
                        }
                    });
                    
                    // Show warning if current selected dept is taken
                    if (managerIdInDept && managerIdInDept !== currentUserId) {
                        deptHint.show();
                    } else {
                        deptHint.hide();
                    }
                } else {
                    deptSelect.find('option').show();
                    deptHint.hide();
                    managerLine.fadeIn();

                    // SMART SYNC: Auto-select the manager for the selected department
                    if (managerIdInDept) {
                        managerSelect.val(managerIdInDept);
                    }
                }
            }

            roleSelect.on('change', updateUI);
            deptSelect.on('change', function() {
                updateUI();
                // When explicitly changing dept, force the manager to sync
                const isManagerRole = roleSelect.val() === 'Manager';
                if (!isManagerRole) {
                    const managerId = $(this).find('option:selected').data('manager');
                    if (managerId) {
                        $('#ManagerId').val(managerId);
                    }
                }
            });
            updateUI();
        });
    </script>
}
